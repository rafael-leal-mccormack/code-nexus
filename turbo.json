{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build:nexus": {
      "outputs": ["dist/**"],
      "inputs": ["src/**/*"]
    },
    "start:nexus": {
      "outputs": ["dist/**"],
      "inputs": ["src/**"],
      "cache": false
    },
    "build:nexus:react": {
      "outputs": ["dist/**"],
      "inputs": ["src/**", "tsconfig.json"],
      "dependsOn": ["code-nexus#build:nexus"]
    },
    "build:web": {
      "outputs": ["dist/**", "/www/**"],
      "inputs": ["src/**"],
      "dependsOn": ["code-nexus-react#build:nexus:react", "//#copy"]
    },
    "start:web": {
      "outputs": ["dist/**", "/www/**"],
      "inputs": ["src/**"],
      "dependsOn": ["code-nexus-react#build:nexus:react", "//#copy"],
      "cache": false
    },
    "//#copy": {
      "dependsOn": ["code-nexus-react#build:nexus:react"]
    },
    "lint": {}
  }
}