{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build:nexus": {
      "outputs": ["dist/", "/www"]
    },
    "start:nexus": {
      "outputs": ["dist/", "/www"],
      "cache": false
    },
    "build:web": {
      "outputs": ["dist/", "/www"],
      "dependsOn": ["code-nexus#build:nexus"]
    },
    "start:web": {
      "outputs": ["dist/", "/www"],
      "dependsOn": ["code-nexus#build:nexus"],
      "cache": false
    },
    "lint": {}
  }
}